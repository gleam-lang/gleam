----- AFTER ACTION

pub type City {
  City(
    name: String,
    population: Int,
    record: Record,
  )
}

pub type Record {
  Record(train_station: String, station_code: String)
}

pub fn info(city: City) -> String {
  city.name
  <> " has train station "
  <> city.record.train_station
  <> " - "
  <> city.record.station_code
}
