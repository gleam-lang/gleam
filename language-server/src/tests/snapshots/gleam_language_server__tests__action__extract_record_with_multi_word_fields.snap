----- BEFORE ACTION

pub type NewsPost {
  NewsPost(
    title: String,
    subtitle: String,
    author_first_name: String,
    ▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔
    author_last_name: String,
▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔
