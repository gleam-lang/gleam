----- AFTER ACTION

pub type NewsPost {
  NewsPost(
    title: String,
    subtitle: String,
    author: Author,
  )
}

pub type Author {
  Author(first_name: String, last_name: String, url: String)
}

pub fn display_post(post: NewsPost) -> String {
  post.title <> " - " <> post.author.last_name <> ", " <> post.author.first_name
}
