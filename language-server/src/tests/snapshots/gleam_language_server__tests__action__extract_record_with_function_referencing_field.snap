----- AFTER ACTION

pub type NewsPost {
  NewsPost(
    title: String,
    subtitle: String,
    author: Author,
  )
}

pub type Author {
  Author(name: String, url: String)
}

pub fn display_post(post: NewsPost) -> String {
  post.title <> " - " <> post.author.name
}
