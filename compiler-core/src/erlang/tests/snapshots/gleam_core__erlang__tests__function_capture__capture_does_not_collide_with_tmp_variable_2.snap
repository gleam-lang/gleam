----- SOURCE CODE

pub fn main() {
  let tmp = fn(x, y) { x + y }
  let func = fn() { tmp }
  let tmp = func()(1, _)

  tmp(2)
}

----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([main/0]).

-spec main() -> integer().
main() ->
    Tmp = fun(X, Y) ->
        X + Y
    end,
    Func = fun() ->
        Tmp
    end,
    Tmp@1 = begin
        Tmp@2 = Func(),
        fun(_capture) ->
            Tmp@2(1, _capture)
        end
    end,
    Tmp@1(2).
