----- SOURCE CODE

pub fn main() {
  { 1 |> add }(1)
}

pub fn add(x) {
  fn(y) { x + y }
}


----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([add/1, main/0]).

-spec add(integer()) -> fun((integer()) -> integer()).
add(X) ->
    fun(Y) ->
        X + Y
    end.

-spec main() -> integer().
main() ->
    begin
        _pipe = 1,
        add(_pipe)
    end(1).
