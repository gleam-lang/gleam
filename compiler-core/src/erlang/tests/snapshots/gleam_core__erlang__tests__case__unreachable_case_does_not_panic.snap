----- SOURCE CODE

pub fn go(x) {
  case x {
    [_, ..] -> []
    [_, ..rest] | rest -> rest
  }
}


----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([go/1]).

-spec go(list(L)) -> list(L).
go(X) ->
    case X of
        [_ | _] ->
            [];

        [_ | Rest] ->
            Rest;

        Rest ->
            Rest
    end.
