pub fn concat(name) {
  name <> { "/" } <> name
}


----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([concat/1]).

-spec concat(binary()) -> binary().
concat(Name) ->
    <<<<Name/binary, "/"/utf8>>/binary, Name/binary>>.
