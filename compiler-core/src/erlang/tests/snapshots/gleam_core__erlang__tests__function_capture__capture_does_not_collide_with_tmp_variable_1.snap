pub fn main() {
  let tmp = fn() {
    fn(x) { x }
  }
  let f = tmp()(_)

  f(0)
}

----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([main/0]).

-spec main() -> integer().
main() ->
    Tmp = fun() ->
        fun(X) ->
            X
        end
    end,
    F = begin
        Tmp@1 = Tmp(),
        fun(_capture) ->
            Tmp@1(_capture)
        end
    end,
    F(0).
