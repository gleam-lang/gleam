----- SOURCE CODE

import mod.{b, c, a}

pub fn go(x) {
  case x {
    _ if x == b -> "b"
    _ if x == a -> "a"
    _ if x == c -> "c"
    _ -> "dunno"
  }
}


----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([go/1]).

-spec go(integer()) -> binary().
go(X) ->
    _value = mod:a(),
    _value@1 = mod:b(),
    _value@2 = mod:c(),
    case X of
        _ when X =:= _value@1 ->
            ~"b";

        _ when X =:= _value ->
            ~"a";

        _ when X =:= _value@2 ->
            ~"c";

        _ ->
            ~"dunno"
    end.
