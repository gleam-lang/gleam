----- SOURCE CODE

pub fn main() {
  echo wibble(1, 2) as message()
}

fn wibble(n: Int, m: Int) { n + m }
fn message() { "Hello!" }


----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([main/0]).

-spec message() -> binary().
message() ->
    ~"Hello!".

-spec wibble(integer(), integer()) -> integer().
wibble(N, M) ->
    N + M.

-spec main() -> integer().
main() ->
    echo(wibble(1, 2), message(), ~"project/test/my/mod.gleam", 3).

