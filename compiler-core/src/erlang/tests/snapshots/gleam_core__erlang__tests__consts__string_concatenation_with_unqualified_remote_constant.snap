import mod.{name}

pub fn wibble() {
  "Hello, " <> name <> "!"
}



----- COMPILED ERLANG
-module(my@mod).
-compile([no_auto_import, nowarn_ignored, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch, inline]).
-export([wibble/0]).

-spec wibble() -> binary().
wibble() ->
    <<<<"Hello, "/utf8, (mod:name())/binary>>/binary, "!"/utf8>>.
