-- BEFORE
---- the_module
pub fn pair(a: Int, b: Float) { #(a, b) }

-- AFTER
---- the_module
pub fn pair(a: a, b: a) { #(a, b) }

-- MAJOR

== the_module ==
- pub fn pair(Int, Float) -> #(Int, Float)
+ pub fn pair(a, a) -> #(a, a)
