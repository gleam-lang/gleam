pub fn main(string: String, result: Result(Int, Nil), flag: Bool) -> String {
  case string, result {
    "abcd", _ if flag -> "0"
    "abc" <> _, _ -> "2"
    "abcd", Ok(_) -> "3"
    "abcd" <> rest, _ if flag -> rest
    _, _ -> "X"
  }
}

