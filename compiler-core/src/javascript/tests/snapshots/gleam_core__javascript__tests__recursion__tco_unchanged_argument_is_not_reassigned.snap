----- SOURCE CODE

pub fn main(x, unchanged) {
  case x {
    0 -> unchanged
    _ -> main(x - 1, unchanged)
  }
}


----- COMPILED JAVASCRIPT
export function main(x, unchanged) {
  while (true) {
    if (x === 0) {
      return unchanged;
    } else {
      x = x - 1;
    }
  }
}
