----- SOURCE CODE

import mod.{b, c, a}

pub fn go(x) {
  case x {
    _ if x == b -> "b"
    _ if x == a -> "a"
    _ if x == c -> "c"
    _ -> "dunno"
  }
}


----- COMPILED JAVASCRIPT
import * as $mod from "../../dep/mod.mjs";
import { b, c, a } from "../../dep/mod.mjs";

export function go(x) {
  if (x === b) {
    return "b";
  } else if (x === a) {
    return "a";
  } else if (x === c) {
    return "c";
  } else {
    return "dunno";
  }
}
