----- SOURCE CODE

pub fn wibble(x) {
  case x {
    Ok(_) if False || True -> "Ok"
    _ -> "Error"
  }
}


----- COMPILED JAVASCRIPT
import { Ok } from "../gleam.mjs";

export function wibble(x) {
  if (x instanceof Ok && (false || true)) {
    return "Ok";
  } else {
    return "Error";
  }
}
