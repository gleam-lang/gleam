----- SOURCE CODE

import mod

pub fn go(x) {
  case x {
    _ if x == mod.b -> "b"
    _ if x == mod.a -> "a"
    _ if x == mod.c -> "c"
    _ -> "dunno"
  }
}


----- COMPILED JAVASCRIPT
import * as $mod from "../../dep/mod.mjs";

export function go(x) {
  if (x === ($mod.b)) {
    return "b";
  } else if (x === ($mod.a)) {
    return "a";
  } else if (x === ($mod.c)) {
    return "c";
  } else {
    return "dunno";
  }
}
