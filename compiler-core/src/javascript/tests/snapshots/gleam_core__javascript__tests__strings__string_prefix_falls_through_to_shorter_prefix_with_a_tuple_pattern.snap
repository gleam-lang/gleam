----- SOURCE CODE

pub fn go(a: #(Int), b: String) -> Int {
  case a, b {
    #(1), "ab" <> _ -> 1
    _, "a" <> _ -> 2
    _, _ -> 3
  }
}


----- COMPILED JAVASCRIPT
export function go(a, b) {
  if (b.startsWith("ab") && a[0] === 1) {
    return 1;
  } else if (b.charCodeAt(0) === 97) {
    return 2;
  } else {
    return 3;
  }
}
