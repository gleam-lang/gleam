----- COMPILED JAVASCRIPT
import { makeError, toBitArray, sizedInt } from "../gleam.mjs";

const FILEPATH = "src/module.gleam";

function fail() {
  throw makeError("panic", FILEPATH, "my/mod", 3, "fail", "oh no!", {})
}

export function main() {
  return toBitArray([sizedInt(fail(), 0, true)]);
}
