pub fn main(x) {
  case x {
    <<"" as a:utf8>> -> a
    _ -> "b"
  }
}


----- COMPILED JAVASCRIPT
export function main(x) {
  if (x.bitSize === 0) {
    let a = "";
    return a;
  } else {
    return "b";
  }
}
