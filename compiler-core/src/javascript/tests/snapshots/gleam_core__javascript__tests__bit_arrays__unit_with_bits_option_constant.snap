----- COMPILED JAVASCRIPT
import { toBitArray, bitArraySlice } from "../gleam.mjs";

export const bits = /* @__PURE__ */ toBitArray([1, 2, 3]);

export const more_bits = /* @__PURE__ */ toBitArray([bitArraySlice(bits, 0, 24)]);

export function main() {
  return more_bits;
}
