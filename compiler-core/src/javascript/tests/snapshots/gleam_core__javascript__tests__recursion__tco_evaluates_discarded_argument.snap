----- SOURCE CODE

@external(javascript, "utils", "observe")
fn observe(x: Int) -> Int

pub fn main(x, _) {
  case x {
    0 -> Nil
    _ -> main(x - 1, observe(x))
  }
}


----- COMPILED JAVASCRIPT
import { observe } from "utils";

export function main(loop$x, _) {
  while (true) {
    let x = loop$x;
    if (x === 0) {
      return undefined;
    } else {
      loop$x = x - 1;
      observe(x);
    }
  }
}
