----- SOURCE CODE

pub fn go(input: String, x: Int) -> Int {
  case input, x {
    "ab", y if y > 4 -> 1
    "a" <> _, _ -> 400
    _, _ -> 999
  }
}


----- COMPILED JAVASCRIPT
export function go(input, x) {
  if (input === "ab") {
    let y = x;
    if (y > 4) {
      return 1;
    } else {
      return 999;
    }
  } else if (input.charCodeAt(0) === 97) {
    return 400;
  } else {
    return 999;
  }
}
