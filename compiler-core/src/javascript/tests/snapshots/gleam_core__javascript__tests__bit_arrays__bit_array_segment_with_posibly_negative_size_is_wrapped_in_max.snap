pub fn go(bits, size) {
  <<bits:bits-size(size)>>
}


----- COMPILED JAVASCRIPT
import { toBitArray, bitArraySlice } from "../gleam.mjs";

export function go(bits, size) {
  return toBitArray([bitArraySlice(bits, 0, Math.max(0, size))]);
}
