pub fn main() {
  let func = fn() {
    fn(x) { x }
  }
  let tmp = func()(_)

  tmp(0)
}

----- COMPILED JAVASCRIPT
export function main() {
  let func = () => { return (x) => { return x; }; };
  let _block;
  {
    let tmp = func();
    _block = (_capture) => { return tmp(_capture); };
  }
  let tmp = _block;
  return tmp(0);
}
