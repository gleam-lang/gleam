import { Empty as $Empty } from "../gleam.mjs";

export function go(n, x) {
  if (x instanceof $Empty) {
    if (n === 1) {
      return x;
    } else {
      return x;
    }
  } else {
    let $ = x.tail;
    if ($ instanceof $Empty) {
      if (n === 3 && x.head === 1) {
        return x;
      } else {
        return x;
      }
    } else if ($.tail instanceof $Empty) {
      return x;
    } else if (n === 3 && x.head === 1) {
      return x;
    } else {
      return x;
    }
  }
}
