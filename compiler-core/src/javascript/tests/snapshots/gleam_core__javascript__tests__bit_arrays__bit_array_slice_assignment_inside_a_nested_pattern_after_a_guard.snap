----- SOURCE CODE

pub fn go(b: Bool, flag: Bool, r: Result(BitArray, Nil)) -> BitArray {
  case b, r {
    True, _ if flag -> <<1>>
    _, Ok(<<x:bits>>) -> x
    _, _ -> <<>>
  }
}


----- COMPILED JAVASCRIPT
import { Ok, toBitArray, bitArraySlice } from "../gleam.mjs";

export function go(b, flag, r) {
  if (b) {
    if (flag) {
      return toBitArray([1]);
    } else if (r instanceof Ok) {
      let x = bitArraySlice(r[0], 0);
      return x;
    } else {
      return toBitArray([]);
    }
  } else if (r instanceof Ok) {
    let x = bitArraySlice(r[0], 0);
    return x;
  } else {
    return toBitArray([]);
  }
}
