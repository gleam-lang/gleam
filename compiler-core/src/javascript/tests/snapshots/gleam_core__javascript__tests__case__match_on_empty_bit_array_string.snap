pub fn main(x) {
  case x {
    <<"":utf8>> -> "a"
    _ -> "b"
  }
}


----- COMPILED JAVASCRIPT
export function main(x) {
  if (x.bitSize === 0) {
    return "a";
  } else {
    return "b";
  }
}
