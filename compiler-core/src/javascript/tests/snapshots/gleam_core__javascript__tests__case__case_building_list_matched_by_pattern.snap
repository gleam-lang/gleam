import { Empty as $Empty } from "../gleam.mjs";

export function go(x) {
  if (x instanceof $Empty) {
    return x;
  } else {
    let $ = x.tail;
    if ($ instanceof $Empty) {
      if (x.head === 1) {
        return x;
      } else {
        return x;
      }
    } else if ($.tail instanceof $Empty) {
      return x;
    } else if (x.head === 1) {
      return x;
    } else {
      return x;
    }
  }
}
