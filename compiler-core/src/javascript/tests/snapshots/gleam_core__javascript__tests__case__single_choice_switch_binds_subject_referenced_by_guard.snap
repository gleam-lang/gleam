import { Empty as $Empty, List$Empty$const as $List$Empty$const } from "../gleam.mjs";

export function go(x) {
  if (x instanceof $Empty) {
    return $List$Empty$const;
  } else {
    let $ = x.tail;
    if ($ instanceof $Empty) {
      return $List$Empty$const;
    } else {
      let b = $.head;
      if (b > 0) {
        return x;
      } else {
        return $List$Empty$const;
      }
    }
  }
}
