----- SOURCE CODE

pub fn main(x) {
  case x {
    0 -> Nil
    _ -> {
      let y = x
      main(y - 1)
    }
  }
}


----- COMPILED JAVASCRIPT
export function main(x) {
  while (true) {
    if (x === 0) {
      return undefined;
    } else {
      let y = x;
      x = y - 1;
    }
  }
}
